<!-- SISYPHUS BREWING CUSTOM FOOTER -->
<footer class="sb-footer">
  <div class="sb-footer-container">
    {%- assign sb_footer_logo = images['sisyphus-banner-blue.png'] | default: settings.logo -%}
    {%- if sb_footer_logo != blank -%}
      <a href="{{ routes.root_url }}" class="sb-footer-logo">
        {{ sb_footer_logo | image_url: width: 440 | image_tag: width: 220, alt: shop.name, loading: 'lazy' }}
      </a>
    {%- endif -%}
    <div class="sb-footer-grid">
      
      <!-- Column 1: Location & Social -->
      <div class="sb-footer-col">
        <h4 class="sb-footer-title">Location</h4>
        <p class="sb-footer-text">
          <strong>Sisyphus</strong><br>
          712 Ontario Ave W<br>
          Minneapolis, MN 55403
        </p>
        <div class="sb-social-links">
          <a href="https://instagram.com/sisyphusbrewing" target="_blank" rel="noopener">Instagram</a>
          <a href="https://facebook.com/sisyphusbrewing" target="_blank" rel="noopener">Facebook</a>
        </div>
      </div>

      <!-- Column 2: Updated Hours -->
      <div class="sb-footer-col">
        <h4 class="sb-footer-title">Taproom Hours</h4>
        <ul class="sb-footer-list">
          <li><strong>Mon:</strong> Closed <em>(Available for Private Events)</em></li>
          <li><strong>Tue - Wed:</strong> 4pm - 9pm</li>
          <li><strong>Thu:</strong> 4pm - 11pm</li>
          <li><strong>Fri - Sat:</strong> 1pm - 11pm</li>
          <li><strong>Sun:</strong> 1pm - 6pm</li>
        </ul>
      </div>

      <!-- Column 3: Updated Parking -->
      <div class="sb-footer-col">
        <h4 class="sb-footer-title">Parking</h4>
        <ul class="sb-footer-list">
          <li>Free street parking on Ontario &amp; Aldrich</li>
          <li>Our back customer parking lot</li>
          <li>Dunwoody Parking Lot on Aldrich</li>
        </ul>
      </div>

      <!-- Column 4: Quick Links -->
      <div class="sb-footer-col">
        <h4 class="sb-footer-title">Quick Links</h4>
        <ul class="sb-footer-list">
          <li><a href="/collections/comedy-and-events">Comedy Tickets &amp; Events</a></li>
          <li><a href="/pages/beer">Drink Menu</a></li>
          <li><a href="/pages/taproom">Taproom FAQ</a></li>
          <li><a href="/pages/rental">Private Rentals</a></li>
          <li><a href="/pages/about-sisyphus-brewing">Our Story</a></li>
          <li><a href="/pages/accessibility">Accessibility</a></li>
        </ul>
      </div>

    </div>
    
    <div class="sb-footer-bottom">
      <p>&copy; {{ 'now' | date: "%Y" }} Sisyphus. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .sb-footer {
    background-color: #1f1d1d;
    color: #b5b1b1;
    padding: 5rem 1.5rem 2rem 1.5rem;
    border-top: 1px solid rgba(74, 108, 134, 0.2);
    font-family: inherit;
    line-height: 1.6;
  }
  .sb-footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .sb-footer-logo {
    display: block;
    width: 220px;
    max-width: 70%;
    margin: 0 auto 4rem auto;
  }
  .sb-footer-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sb-footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 3rem;
    margin-bottom: 4rem;
  }
  .sb-footer-title {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1.25rem 0;
  }
  .sb-footer-text, .sb-footer-list {
    margin: 0;
    padding: 0;
    font-size: 1.5rem;
    list-style: none;
  }
  .sb-footer-list li {
    margin-bottom: 0.75rem;
  }
  .sb-footer-list strong {
    color: #e4e1e1;
  }
  .sb-footer-list em {
    color: #a9c3d8;
    font-style: normal;
    font-size: 1.35rem;
    display: block;
    margin-top: 0.15rem;
  }
  .sb-footer-list a {
    color: #b5b1b1;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .sb-footer-list a:hover {
    color: #a9c3d8;
  }
  .sb-social-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .sb-social-links a {
    color: #c9dae8;
    font-size: 1.3rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(74, 108, 134, 0.1);
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    border: 1px solid rgba(74, 108, 134, 0.3);
    transition: all 0.2s ease;
  }
  .sb-social-links a:hover {
    background: #4a6c86;
    color: #ffffff;
  }
  .sb-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    text-align: center;
    font-size: 1.3rem;
    color: #b5b1b1;
  }
  .sb-footer .sb-footer-bottom p {
    color: #b5b1b1 !important;
    font-size: 1.3rem !important;
  }
  .sb-footer .sb-footer-title {
    font-size: 1.5rem !important;
  }
</style>

{% schema %}
{
  "name": "Custom Footer",
  "settings": []
}
{% endschema %}