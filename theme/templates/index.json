{
  "sections": {
    "custom_liquid_hYn8Q4": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- SISYPHUS BREWING COMPLETE HOMEPAGE -->\n<div class=\"sb-wrap\">\n\n  <!-- 1. HERO SECTION -->\n  <section class=\"sb-hero\">\n    <div class=\"sb-hero-overlay\"></div>\n    <div class=\"sb-hero-inner\">\n      <h1 class=\"sb-hero-title\">WORLD CLASS COMEDY</h1>\n      <p class=\"sb-hero-subtitle\">Locally Made Beer.</p>\n      <p class=\"sb-hero-desc\">\n        Minneapolis’ most intimate 100-seat showroom. No drink minimums—just fresh small-batch pours, touring national headliners, and local favorites every weekend.\n      </p>\n      <div class=\"sb-btn-row\">\n        <a href=\"/collections/comedy-and-events\" class=\"sb-btn sb-btn-blue\">Comedy Tickets & Events</a>\n        <a href=\"/pages/beer\" class=\"sb-btn sb-btn-outline\">Drink Menu</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 2. COMEDY SHOWROOM EXPERIENCE -->\n  <section class=\"sb-section sb-comedy\">\n    <div class=\"sb-container\">\n      <div class=\"sb-section-head\">\n        <span class=\"sb-tag\">The Showroom</span>\n        <h2>Stand-Up Without the Gimmicks</h2>\n        <p>A dedicated, sound-treated 100-seat comedy theater right inside the brewery. Front-row intimacy, national touring acts, and pints poured right outside the door.</p>\n        \n        <!-- PROMINENT ARTIST-FIRST BANNER -->\n        <div class=\"sb-artist-banner\">\n          <div class=\"sb-artist-badge\">★ ARTIST-FIRST VENUE ★</div>\n          <div class=\"sb-artist-banner-text\">\n            100% of Ticket Sales &amp; Ticket Fees Go Directly to Performers\n          </div>\n          <div class=\"sb-artist-banner-sub\">\n            Zero club cuts. Every ticket and fee directly supports the headliners, features, and hosts on stage.\n          </div>\n        </div>\n      </div>\n\n      <!-- 3 FEATURE BOXES -->\n      <div class=\"sb-comedy-grid\">\n        <div class=\"sb-feature-box\">\n          <h3>Weekend Headliners</h3>\n          <p>Friday and Saturday showcases featuring national touring comedians seen on Netflix, Comedy Central, HBO, and late night.</p>\n          <a href=\"/collections/comedy-and-events\" class=\"sb-text-link\">Upcoming Shows &rarr;</a>\n        </div>\n\n        <div class=\"sb-feature-box\">\n          <h3>Thursday Open Mic</h3>\n          <p>The Twin Cities' premier proving ground every Thursday at 8 PM. Free admission, walk-ins welcome, zero tickets required.</p>\n          <a href=\"/pages/open-mic\" class=\"sb-text-link\">Open Mic Info &rarr;</a>\n        </div>\n\n        <div class=\"sb-feature-box\">\n          <h3>Zero Drink Minimums</h3>\n          <p>Standard comedy clubs enforce mandatory two-drink minimums. We let our rotating small-batch draft board speak for itself.</p>\n          <a href=\"/pages/beer\" class=\"sb-text-link\">Drink Menu &rarr;</a>\n        </div>\n      </div>\n\n      <div class=\"sb-center-btn\">\n        <a href=\"/collections/comedy-and-events\" class=\"sb-btn sb-btn-blue\">View Full Comedy Calendar</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 3. BREWERY & TAPROOM PIVOT -->\n  <section class=\"sb-section sb-taproom\">\n    <div class=\"sb-container sb-split-grid\">\n      <div class=\"sb-split-image\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0000/0000/files/placeholder-taproom.jpg\" alt=\"Sisyphus Brewing Taproom\" loading=\"lazy\">\n      </div>\n      <div class=\"sb-split-content\">\n        <span class=\"sb-tag\">The Brewery</span>\n        <h2>Small-Batch Craft Beer</h2>\n        <p>\n          Named after the myth of Sisyphus, we roll the boulder every week—brewing experimental, small-batch beers by hand. From crisp lagers and hazy IPAs to stouts and sours, taps rotate constantly so there’s always something new pouring.\n        </p>\n        <p>\n          Whether you're stopping in for a flight before a comedy show, playing shuffleboard, or catching up with friends, our taproom is dog-friendly and BYO food welcome.\n        </p>\n        <blockquote class=\"sb-motto\">\n          <span class=\"sb-motto-fr\">&laquo; Il faut imaginer Sisyphe heureux. &raquo;</span>\n          <span class=\"sb-motto-en\">One must imagine Sisyphus happy &middot; Albert Camus</span>\n        </blockquote>\n        <div class=\"sb-btn-row sb-taproom-btns\">\n          <a href=\"/pages/beer\" class=\"sb-btn sb-btn-blue\">Drink Menu</a>\n          <a href=\"/pages/taproom\" class=\"sb-btn sb-btn-outline\">Taproom FAQ</a>\n          <a href=\"/pages/about-sisyphus-brewing\" class=\"sb-btn sb-btn-outline\">Our Story</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 4. PRIVATE EVENTS / RENTALS BANNER -->\n  <section class=\"sb-cta-banner\">\n    <div class=\"sb-container sb-cta-inner\">\n      <h2>Host Your Event at Sisyphus</h2>\n      <p>Reserve our 100-seat comedy theater or book the full taproom for private parties, corporate events, fundraisers, and celebrations.</p>\n      <a href=\"/pages/rental\" class=\"sb-btn sb-btn-blue\">Private Rentals</a>\n    </div>\n  </section>\n\n</div>\n\n<style>\n  .sb-wrap {\n    font-family: inherit;\n    color: #ffffff;\n    background-color: #0b101b;\n    line-height: 1.6;\n  }\n  .sb-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1.5rem;\n  }\n  .sb-section {\n    padding: 5rem 0;\n  }\n  .sb-tag {\n    display: inline-block;\n    font-size: 0.85rem;\n    font-weight: 800;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: #60a5fa;\n    margin-bottom: 0.5rem;\n  }\n\n  /* 1. Hero */\n  .sb-hero {\n    position: relative;\n    min-height: 80vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background: linear-gradient(180deg, rgba(11, 16, 27, 0.75) 0%, rgba(11, 16, 27, 0.95) 100%), \n                url('https://cdn.shopify.com/s/files/1/0000/0000/files/placeholder-hero.jpg') center center / cover no-repeat, \n                #0b101b;\n    color: #ffffff;\n    padding: 5rem 1.5rem;\n  }\n  .sb-hero-overlay {\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.18) 0%, transparent 70%);\n    z-index: 1;\n  }\n  .sb-hero-inner {\n    position: relative;\n    z-index: 2;\n    max-width: 900px;\n  }\n  .sb-hero-title {\n    font-size: clamp(2.8rem, 7vw, 5.2rem);\n    font-weight: 900;\n    letter-spacing: 0.04em;\n    line-height: 1.05;\n    margin: 0 0 0.4rem 0;\n    text-transform: uppercase;\n    color: #ffffff !important;\n  }\n  .sb-hero-subtitle {\n    font-size: clamp(1.4rem, 3.5vw, 2.2rem);\n    font-weight: 700;\n    color: #f59e0b !important;\n    margin: 0 0 1.5rem 0;\n  }\n  .sb-hero-desc {\n    font-size: clamp(1rem, 2vw, 1.25rem);\n    max-width: 680px;\n    margin: 0 auto 2.5rem auto;\n    color: #cbd5e1;\n  }\n\n  /* Buttons */\n  .sb-btn-row {\n    display: flex;\n    gap: 1rem;\n    justify-content: center;\n    flex-wrap: wrap;\n  }\n  .sb-btn {\n    display: inline-block;\n    padding: 0.95rem 1.8rem;\n    font-size: 0.95rem;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    text-decoration: none;\n    border-radius: 6px;\n    transition: all 0.2s ease;\n  }\n  .sb-btn-blue {\n    background-color: #2563eb !important;\n    color: #ffffff !important;\n    border: 2px solid #2563eb !important;\n    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45) !important;\n  }\n  .sb-btn-blue:hover {\n    background-color: #1d4ed8 !important;\n    border-color: #1d4ed8 !important;\n    color: #ffffff !important;\n    transform: translateY(-2px);\n  }\n  .sb-btn-outline {\n    background-color: transparent !important;\n    color: #ffffff !important;\n    border: 2px solid #ffffff !important;\n  }\n  .sb-btn-outline:hover {\n    background-color: rgba(255, 255, 255, 0.15) !important;\n    border-color: #ffffff !important;\n    color: #ffffff !important;\n    transform: translateY(-2px);\n  }\n\n  /* 2. Comedy Section */\n  .sb-comedy {\n    background-color: #0b101b;\n    border-top: 1px solid rgba(37, 99, 235, 0.2);\n  }\n  .sb-section-head {\n    text-align: center;\n    max-width: 860px;\n    margin: 0 auto 3.5rem auto;\n  }\n  .sb-section-head h2 {\n    font-size: clamp(2rem, 4vw, 2.75rem);\n    margin: 0 0 1rem 0;\n    font-weight: 800;\n    color: #ffffff !important;\n  }\n  .sb-section-head p {\n    color: #94a3b8;\n    font-size: 1.1rem;\n    margin-bottom: 2rem;\n  }\n\n  /* Large Artist-First Banner */\n  .sb-artist-banner {\n    background: linear-gradient(180deg, rgba(37, 99, 235, 0.18) 0%, rgba(19, 27, 46, 0.85) 100%);\n    border: 2px solid #2563eb;\n    border-radius: 12px;\n    padding: 1.75rem 2rem;\n    box-shadow: 0 0 25px rgba(37, 99, 235, 0.25);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 0.5rem;\n  }\n  .sb-artist-badge {\n    background-color: #2563eb;\n    color: #ffffff;\n    font-size: 0.8rem;\n    font-weight: 900;\n    letter-spacing: 0.1em;\n    padding: 0.35rem 0.85rem;\n    border-radius: 9999px;\n    display: inline-block;\n  }\n  .sb-artist-banner-text {\n    font-size: clamp(1.2rem, 2.8vw, 1.65rem);\n    font-weight: 900;\n    color: #ffffff;\n    letter-spacing: 0.02em;\n    line-height: 1.3;\n    margin-top: 0.35rem;\n  }\n  .sb-artist-banner-sub {\n    color: #93c5fd;\n    font-size: 0.95rem;\n    font-weight: 600;\n    max-width: 650px;\n    line-height: 1.5;\n  }\n\n  /* 3-Box Grid */\n  .sb-comedy-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 2rem;\n    margin-bottom: 3.5rem;\n  }\n  .sb-feature-box {\n    background-color: #131b2e;\n    border: 1px solid rgba(37, 99, 235, 0.25);\n    padding: 2.5rem 2rem;\n    border-radius: 8px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    transition: transform 0.2s ease, border-color 0.2s ease;\n  }\n  .sb-feature-box:hover {\n    transform: translateY(-4px);\n    border-color: #2563eb;\n  }\n  .sb-feature-box h3 {\n    margin: 0 0 0.75rem 0;\n    font-size: 1.35rem;\n    color: #ffffff !important;\n  }\n  .sb-feature-box p {\n    color: #94a3b8;\n    margin: 0 0 1.5rem 0;\n    font-size: 0.95rem;\n    line-height: 1.6;\n  }\n  .sb-text-link {\n    font-weight: 700;\n    color: #60a5fa !important;\n    text-decoration: none;\n    font-size: 0.9rem;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .sb-text-link:hover {\n    color: #93c5fd !important;\n    text-decoration: underline;\n  }\n  .sb-center-btn {\n    text-align: center;\n  }\n\n  /* 3. Taproom Split */\n  .sb-taproom {\n    background-color: #0e1524;\n    border-top: 1px solid rgba(255, 255, 255, 0.06);\n  }\n  .sb-split-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 4rem;\n    align-items: center;\n  }\n  .sb-split-image img {\n    width: 100%;\n    height: 100%;\n    max-height: 480px;\n    object-fit: cover;\n    border-radius: 8px;\n    border: 1px solid rgba(37, 99, 235, 0.25);\n    display: block;\n  }\n  .sb-split-content h2 {\n    font-size: clamp(2rem, 4vw, 2.75rem);\n    margin: 0 0 1rem 0;\n    font-weight: 800;\n    color: #ffffff !important;\n  }\n  .sb-split-content p {\n    color: #94a3b8;\n    margin-bottom: 1.25rem;\n    font-size: 1.05rem;\n  }\n  .sb-taproom-btns {\n    justify-content: flex-start;\n    margin-top: 1.5rem;\n  }\n\n  /* 4. CTA Banner */\n  .sb-cta-banner {\n    background-color: #0b101b;\n    border-top: 1px solid rgba(37, 99, 235, 0.25);\n    color: #ffffff;\n    padding: 5rem 1.5rem;\n    text-align: center;\n  }\n  .sb-cta-inner {\n    max-width: 700px;\n    margin: 0 auto;\n  }\n  .sb-cta-inner h2 {\n    font-size: clamp(2rem, 3.5vw, 2.6rem);\n    color: #ffffff !important;\n    margin: 0 0 1rem 0;\n  }\n  .sb-cta-inner p {\n    color: #94a3b8;\n    margin: 0 0 2rem 0;\n    font-size: 1.1rem;\n  }\n\n  /* Responsive Mobile */\n  @media screen and (max-width: 850px) {\n    .sb-comedy-grid {\n      grid-template-columns: 1fr;\n    }\n    .sb-artist-banner {\n      padding: 1.5rem 1.25rem;\n    }\n    .sb-split-grid {\n      grid-template-columns: 1fr;\n      gap: 2.5rem;\n    }\n    .sb-taproom-btns {\n      justify-content: center;\n    }\n    .sb-split-content {\n      text-align: center;\n    }\n    .sb-btn-row {\n      flex-direction: column;\n      align-items: center;\n      gap: 0.75rem;\n    }\n    .sb-btn {\n      width: 100%;\n      max-width: 320px;\n      text-align: center;\n      box-sizing: border-box;\n    }\n  }\n\n  /* The last line of Camus's Myth of Sisyphus, which the place is named for. */\n  .sb-motto { font-style: normal; margin: 2.2rem 0 2.6rem; padding: 0.2rem 0 0.2rem 1.8rem; border-left: 3px solid #4a6c86; }\n  html body .sb-motto-fr { display: block; color: #ffffff !important; font-size: clamp(1.9rem, 2vw, 2.3rem); letter-spacing: 0.02em; line-height: 1.4; }\n  html body .sb-motto-en { display: block; margin-top: 0.5rem; color: #a9c3d8 !important; font-size: 1.3rem; letter-spacing: 0.1em; text-transform: uppercase; }\n</style>",
